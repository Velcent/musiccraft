<?xml version="1.0" encoding="UTF-8"?>
<!--
  MusicCraft Windows installer (WiX Toolset v4).

  Build (see .github/workflows/release.yml):
    wix build -arch x64 -d Version=0.1.0 -d Exe=target\release\musiccraft.exe ^
      -d Ort=ort -d Icon=packaging\icons\musiccraft.ico -o MusicCraft.msi ^
      packaging\windows\musiccraft.wxs

  Ort is the folder packaging/onnxruntime/fetch.sh filled: ONNX Runtime for
  stem splitting, installed beside the program.

  Installs per machine to "C:\Program Files\MusicCraft" and adds a Start menu
  shortcut. Upgrades replace older versions in place (same UpgradeCode).
  KEEP THE UpgradeCode BELOW FIXED FOREVER, or upgrades will install side by side.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MusicCraft"
      Manufacturer="MusicCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="97AC220A-017B-4EA2-909A-3CF05FD93DD8"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of MusicCraft is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="MusicCraftIcon" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="MusicCraftIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/bhimio1/musiccraft" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MusicCraft">
        <Component Id="MusicCraftExeComponent" Guid="*">
          <File Id="MusicCraftExe" Name="musiccraft.exe" Source="$(var.Exe)" KeyPath="yes" />
        </Component>
        <Component Id="OnnxRuntimeComponent" Guid="*">
          <File Id="OnnxRuntimeDll" Name="onnxruntime.dll" Source="$(var.Ort)\onnxruntime.dll" KeyPath="yes" />
          <File Id="OnnxRuntimeLicense" Name="ONNXRUNTIME-LICENSE.txt" Source="$(var.Ort)\ONNXRUNTIME-LICENSE.txt" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="*">
        <Shortcut
            Id="MusicCraftStartMenuShortcut"
            Name="MusicCraft"
            Description="Pattern-based digital audio workstation"
            Target="[INSTALLFOLDER]musiccraft.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MusicCraftIcon" />
        <RegistryValue Root="HKLM" Key="Software\MusicCraft" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="MusicCraft" Level="1">
      <ComponentRef Id="MusicCraftExeComponent" />
      <ComponentRef Id="OnnxRuntimeComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
    </Feature>
  </Package>
</Wix>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template: the release workflow replaces @VERSION@ and @DATE@ and writes
  io.github.bhimio1.MusicCraft.metainfo.xml next to it.

  TODO(license): add <project_license>SPDX-ID</project_license> once the project's
  license is chosen. Flathub requires it, and so does any public distribution.
-->
<component type="desktop-application">
  <id>io.github.bhimio1.MusicCraft</id>
  <name>MusicCraft</name>
  <summary>Pattern-based digital audio workstation</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <description>
    <p>
      MusicCraft is a clean-room, pure-Rust digital audio workstation with a
      pattern-based workflow: a channel rack, piano roll, playlist and mixer, with
      familiar default keyboard shortcuts.
    </p>
    <p>
      Every action is a command, so a project can be driven from the interface,
      scripts, a command-line tool, or an AI agent over MCP.
    </p>
  </description>
  <launchable type="desktop-id">io.github.bhimio1.MusicCraft.desktop</launchable>
  <url type="homepage">https://github.com/bhimio1/musiccraft</url>
  <url type="bugtracker">https://github.com/bhimio1/musiccraft/issues</url>
  <developer id="io.github.bhimio1">
    <name>MusicCraft contributors</name>
  </developer>
  <content_rating type="oars-1.1" />
  <provides>
    <binary>musiccraft</binary>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <releases>
    <release version="@VERSION@" date="@DATE@" />
  </releases>
</component>

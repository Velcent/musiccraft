# MusicCraft default keymap.
#
# One binding per line:  <chord> = <invocation>
# A chord is optional modifiers (Ctrl, Shift, Alt) and a key name, joined by `+`.
# Ctrl means Cmd on macOS. Key names follow egui (Space, F5, A, Plus, Minus, ...).
# Invocations are registry commands, or `view.*` / `ui.*` actions handled by the UI.

# Transport
Space        = transport.toggle
Ctrl+Space   = transport.play_pause
Home         = transport.jump_to_start
Ctrl+H       = transport.panic
L            = transport.toggle_mode
Ctrl+M       = transport.toggle_metronome
R            = record.toggle
Ctrl+E       = record.toggle_step_edit
Ctrl+P       = record.toggle_count_in
Ctrl+I       = record.toggle_wait
Ctrl+T       = ui.typing_keyboard

# Playlist
Alt+T        = ui.add_marker
Ctrl+Insert  = ui.insert_space
Ctrl+Delete  = ui.delete_space

# Tools (piano roll and playlist)
P            = ui.tool draw
B            = ui.tool paint
D            = ui.tool delete
E            = ui.tool select
C            = ui.tool slice
T            = ui.tool mute
Y            = ui.tool play
Z            = ui.tool zoom
S            = ui.toggle_slide
O            = ui.toggle_porta

# Windows
F5           = view.toggle playlist
F6           = view.toggle channel_rack
F7           = view.toggle piano_roll
F9           = view.toggle mixer
Alt+F8       = view.toggle browser
Enter        = view.maximize playlist
Ctrl+Shift+H = view.default_layout
Escape       = view.close_focused
F12          = view.hide_all
Alt+F12      = view.hide_effects
Ctrl+F12     = view.hide_others
F10          = ui.settings
F1           = view.toggle shortcuts

# Patterns
F4           = ui.next_empty_pattern
Shift+F4     = pattern.first_empty
F2           = ui.rename_pattern
1            = pattern.select 1
2            = pattern.select 2
3            = pattern.select 3
4            = pattern.select 4
5            = pattern.select 5
6            = pattern.select 6
7            = pattern.select 7
8            = pattern.select 8
9            = pattern.select 9
Plus         = pattern.next
Minus        = pattern.prev

# History
Ctrl+Z       = edit.undo
Ctrl+Shift+Z = edit.redo
Ctrl+Y       = edit.redo

# Files
Ctrl+N       = ui.save_new_version
Ctrl+O       = ui.open
Ctrl+S       = ui.save
Ctrl+Shift+S = ui.save_as
Ctrl+R       = ui.export
Ctrl+Shift+M = ui.export_midi
